# Database
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Redis (required for background workers)
REDIS_URL=redis://127.0.0.1:6379

# Authentication
JWT_SECRET=change-this-to-a-random-secret-in-production

# AI - Google Gemini
GEMINI_API_KEY=AIza...

# Sentry (optional - for error tracking)
SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=

# Gmail (optional - for email monitoring)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# File Storage
# Files are stored locally in public/uploads/ by default
# For S3, set these:
# AWS_S3_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=